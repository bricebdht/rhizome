# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# ---------------------------------------------------------------------------
# CLIENT VARIABLES (VITE_*)
# ---------------------------------------------------------------------------
# Vite inlines every VITE_* variable into the JavaScript bundle at build time.
# They are shipped to the browser as literal strings: readable by anyone who
# opens devtools. Treat them as public configuration, never as secrets.
#
# This is not a limitation to work around — it is why the TMDB key needs a
# proxy (see docs/plan/phases/phase-2-tmdb.md). If you catch yourself adding
# a credential here, the answer is an endpoint on the proxy instead.

# Base URL of the TMDB proxy. Read once in src/lib/tmdb/client.ts and injected
# into the core client; nothing under src/core/ reads env. (ticket 0205)
VITE_TMDB_PROXY_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# PROXY VARIABLES (server side only)
# ---------------------------------------------------------------------------
# These never appear in the app bundle. They are set wherever the proxy is
# deployed (Cloudflare/Vercel/Netlify dashboard, or a local .dev.vars file)
# and are listed here only so the full surface is visible in one place.

# TMDB API key, v3 auth. The reason the proxy exists. (ticket 0201)
TMDB_API_KEY=

# Comma-separated origins allowed to call the proxy. (ticket 0202)
ALLOWED_ORIGINS=http://localhost:5173
